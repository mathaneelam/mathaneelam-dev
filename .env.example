# Copy this file to `.env.local` and fill in what you have.
# The site works with NONE of these set — see SETUP.md section 3.

# --- The demo's brain (free) -------------------------------------------------
# Get one at https://aistudio.google.com/apikey — no card required.
# Without this the demo answers from a script instead. It still works.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash if left blank.
GEMINI_MODEL=

# --- Recording the voice clips (free, one time) ------------------------------
# Only needed when you run `npm run voice`. Never used by the live site.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
