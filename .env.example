# Copy this file to `.env.local` and fill it in.
# The site still works with NOTHING set — the demo falls back to a scripted
# conversation, which needs no key, no network and no quota.

# --- The only key the site needs ---------------------------------------------
# One provider for both the conversation and the voice.
# From https://sarvam.ai — Indian languages, Tamil included.
SARVAM_API_KEY=

# Optional. Defaults to sarvam-105b-conversations if left blank.
# Note: `sarvam-m` is deprecated, and plain `sarvam-105b` returns a different
# response shape that the code does not read.
SARVAM_MODEL=
